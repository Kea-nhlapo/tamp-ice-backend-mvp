# Safe placeholders only. Copy values into a local, ignored .env file if the
# implemented configuration uses one. Never commit real passwords or secrets.
# Docker Compose supplies the internal DB_URL automatically.
# Set these placeholders in a local .env file before starting containers.
DB_URL=
DB_USERNAME=replace-with-local-database-user
DB_PASSWORD=replace-with-local-database-password
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=3600000
