# Copy this file to .env before running Docker Compose.
# These are development-only placeholders. Replace both secret values locally
# and never commit the resulting .env file.
POSTGRES_DB=tampdb
POSTGRES_USER=tamp
POSTGRES_PASSWORD=replace-with-a-local-database-password

# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-base64-encoded-32-byte-secret
JWT_EXPIRATION_MS=3600000
